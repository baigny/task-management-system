    },
    {
      "name": "Preview member removal",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/members/{{userId}}/removal-preview",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "description": "Owner can preview removal of a member; members can preview their own leave. Owner removal returns 409. Default automatic mode balances unfinished, non-deleted tasks within this project, with stable user-ID ties. The owner is the fallback when no other members remain. Manual mode requires an owner-selected remaining member. Preview changes nothing and is advisory.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"AUTOMATIC\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
