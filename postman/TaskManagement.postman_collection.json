      "name": "Permanently delete project",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/permanent",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "description": "Owner only. Requires prior soft deletion. Irreversibly removes the project, memberships, and project activity."
      },
      "event": [
        {
          "listen": "test",
