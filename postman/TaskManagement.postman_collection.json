{
  "info": {
    "name": "Task Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Process health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        },
        "description": "Checks the HTTP process independently of PostgreSQL."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Database readiness",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ready",
        "auth": {
          "type": "noauth"
        },
        "description": "Queries PostgreSQL. Returns DATABASE_UNAVAILABLE when the database cannot be reached."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Register account",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/register",
        "auth": {
          "type": "noauth"
        },
        "description": "Creates an account and one-hour session. Passwords must match. Duplicate email returns 409. Authentication responses are not cached.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"developer@example.com\",\n  \"name\": \"Developer\",\n  \"password\": \"strong-password-123\",\n  \"confirmPassword\": \"strong-password-123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"token\", data[\"token\"]);",
              "  pm.collectionVariables.set(\"userId\", data[\"user\"][\"id\"]);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "auth": {
          "type": "noauth"
        },
        "description": "Invalid email and password share one response. After five failed attempts per account in 15 minutes, further attempts return 429. Success resets the account counter.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"developer@example.com\",\n  \"password\": \"strong-password-123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"token\", data[\"token\"]);",
              "  pm.collectionVariables.set(\"userId\", data[\"user\"][\"id\"]);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "View profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/users/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "description": "Returns the authenticated account profile without credentials. Response is not cached."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update profile",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/users/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "description": "Changes only the display name. Unknown/protected fields are rejected.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Developer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout current device",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/logout",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "description": "Immediately revokes the supplied session. Other devices stay logged in; login throttling does not block logout."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout all devices",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/logout-all",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "description": "Revokes all of the authenticated account sessions, including the supplied token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    }
  ]
}
