    {
      "name": "Reset password",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/reset-password",
        "auth": {
          "type": "noauth"
        },
        "description": "Consumes a single-use token within 15 minutes, revokes all sessions and outstanding reset tokens, and requires a fresh login. Passwords must match. Expired, invalid, or reused tokens return the same 400 error.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"replacement-password-123\",\n  \"confirmPassword\": \"replacement-password-123\"\n}",
