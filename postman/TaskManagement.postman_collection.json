    {
      "name": "Invite project member",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/invitations",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "description": "Owner only. Returns a seven-day single-use token bound to the normalized email. Reissuing replaces earlier tokens for this project/email. Existing members return 409. No outbound email is sent.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"teammate@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"invitationToken\", data[\"token\"]);",
              "  pm.collectionVariables.set(\"invitationId\", data[\"invitation\"][\"id\"]);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List project invitations",
