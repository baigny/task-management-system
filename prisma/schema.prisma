generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// Models and migrations are added alongside their functional API batches.

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  passwordChangedAt DateTime?
  passwordResets PasswordReset[]
  ownedProjects Project[]
  memberships Membership[]
  deletedProjects Project[] @relation("ProjectDeletedBy")
  activities Activity[]
  sentInvitations Invitation[]
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks Task[] @relation("TaskCreator")
  deletedTasks Task[] @relation("TaskDeletedBy")
  comments Comment[]
  attachments Attachment[]
  notifications Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
  @@index([expiresAt, id])
}

model AuthAttempt {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  @@index([windowStartedAt])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
  @@index([expiresAt, id])
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String       @default("")
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id])
  createdAt   DateTime     @default(now())
  memberships Membership[]
  deletedAt DateTime?
  deletedById String?
  deletedBy User? @relation("ProjectDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  activities Activity[]
  invitations Invitation[]
  tasks Task[]
  notifications Notification[]
  @@index([ownerId])
  @@index([deletedAt, createdAt])
}

model Membership {
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([projectId, userId])
  @@index([userId])
}

model Activity {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String
  entityId String?
  metadata Json @default("{}")
  taskId String?
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([projectId, createdAt, id])
  @@index([projectId, taskId, createdAt, id])
}

model Invitation {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email String
  invitedById String
  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  revokedAt DateTime?
  @@unique([projectId, email])
  @@index([projectId, createdAt])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

model Task {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title String
  description String @default("")
  dueDate DateTime?
  status TaskStatus @default(OPEN)
  assigneeId String?
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy User? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  deletedById String?
  deletedBy User? @relation("TaskDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  comments Comment[]
  attachments Attachment[]
  activities Activity[]
  notifications Notification[]
  @@index([projectId, deletedAt, status, assigneeId])
  @@index([assigneeId, status])
  @@index([projectId, createdAt, id])
}

model Comment {
  id String @id @default(uuid())
  taskId String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String?
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId String?
  parent Comment? @relation("CommentReplies", fields: [parentId, taskId], references: [id, taskId], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  body String?
  createdAt DateTime @default(now())
  deletedAt DateTime?
  @@unique([id, taskId])
  @@index([taskId, parentId, createdAt, id])
  @@index([authorId])
}

model Attachment {
  id String @id @default(uuid())
  taskId String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  storageKey String @unique
  originalName String
  mimeType String
  size Int
  createdAt DateTime @default(now())
  @@index([taskId, createdAt, id])
  @@index([uploaderId])
}

// Independent of task/project foreign keys so deletion work survives parent purges.
model FileCleanup {
  storageKey String @id
  availableAt DateTime @default(now())
  @@index([availableAt, storageKey])
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_UPDATED
  TASK_DELETED
  TASK_RESTORED
  COMMENT_ADDED
  COMMENT_REPLIED
  ATTACHMENT_ADDED
  ATTACHMENT_DELETED
}

model Notification {
  id Int @id @default(autoincrement())
  userId String
  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId String?
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type NotificationType
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  readAt DateTime?
  @@index([userId, id])
  @@index([userId, readAt, id])
  @@index([projectId])
  @@index([taskId])
  @@index([actorId])
}
